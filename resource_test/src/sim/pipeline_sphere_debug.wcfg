<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="pipeline_sphere_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="pipeline_sphere_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="2000.000 ns"></ZoomEndTime>
      <Cursor1Time time="0.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="250"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="35" />
   
   <!-- Clock and Reset -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/clk_in">
      <obj_property name="ElementShortName">clk_in</obj_property>
      <obj_property name="ObjectShortName">clk_in</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/reset">
      <obj_property name="ElementShortName">reset</obj_property>
      <obj_property name="ObjectShortName">reset</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/clk_locked">
      <obj_property name="ElementShortName">clk_locked</obj_property>
      <obj_property name="ObjectShortName">clk_locked</obj_property>
   </wvobject>
   
   <wvobject type="divider" fp_name="divider1">
      <obj_property name="label">Sphere 0 (Producer 0)</obj_property>
   </wvobject>
   
   <!-- Sphere 0 MULT Inputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/mult_wr_valid(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
      <obj_property name="CustomSignalColor">#FFD700</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/pipeline_sphere_tb/mult_wr_tid">
      <obj_property name="ElementShortName">mult_wr_tid[127:0]</obj_property>
      <obj_property name="ObjectShortName">mult_wr_tid[127:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="DisplayFormat">0</obj_property>
   </wvobject>
   
   <!-- Sphere 0 FMA Inputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/fma_wr_valid(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
      <obj_property name="CustomSignalColor">#FFD700</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   
   <!-- Sphere 0 Outputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/output_rd_valid(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
      <obj_property name="CustomSignalColor">#00FF00</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/pipeline_sphere_tb/output_rd_tid">
      <obj_property name="ElementShortName">output_rd_tid[79:0]</obj_property>
      <obj_property name="ObjectShortName">output_rd_tid[79:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/pipeline_sphere_tb/output_rd_data">
      <obj_property name="ElementShortName">output_rd_data[159:0]</obj_property>
      <obj_property name="ObjectShortName">output_rd_data[159:0]</obj_property>
      <obj_property name="Radix">REALRADIX</obj_property>
      <obj_property name="DisplayFormat">2</obj_property>
   </wvobject>
   
   <wvobject type="divider" fp_name="divider2">
      <obj_property name="label">Sphere 1 (Producer 1)</obj_property>
   </wvobject>
   
   <!-- Sphere 1 MULT Inputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/mult_wr_valid(1)">
      <obj_property name="ElementShortName">(1)</obj_property>
      <obj_property name="ObjectShortName">(1)</obj_property>
      <obj_property name="CustomSignalColor">#00BFFF</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   
   <!-- Sphere 1 FMA Inputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/fma_wr_valid(1)">
      <obj_property name="ElementShortName">(1)</obj_property>
      <obj_property name="ObjectShortName">(1)</obj_property>
      <obj_property name="CustomSignalColor">#00BFFF</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   
   <!-- Sphere 1 Outputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/output_rd_valid(1)">
      <obj_property name="ElementShortName">(1)</obj_property>
      <obj_property name="ObjectShortName">(1)</obj_property>
      <obj_property name="CustomSignalColor">#00FF00</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   
   <wvobject type="divider" fp_name="divider3">
      <obj_property name="label">Sphere 2 (Producer 2)</obj_property>
   </wvobject>
   
   <!-- Sphere 2 MULT Inputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/mult_wr_valid(2)">
      <obj_property name="ElementShortName">(2)</obj_property>
      <obj_property name="ObjectShortName">(2)</obj_property>
      <obj_property name="CustomSignalColor">#FF1493</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   
   <!-- Sphere 2 FMA Inputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/fma_wr_valid(2)">
      <obj_property name="ElementShortName">(2)</obj_property>
      <obj_property name="ObjectShortName">(2)</obj_property>
      <obj_property name="CustomSignalColor">#FF1493</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   
   <!-- Sphere 2 Outputs -->
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/output_rd_valid(2)">
      <obj_property name="ElementShortName">(2)</obj_property>
      <obj_property name="ObjectShortName">(2)</obj_property>
      <obj_property name="CustomSignalColor">#00FF00</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   
   <wvobject type="divider" fp_name="divider4">
      <obj_property name="label">MULT Unit 0 FIFO (Sphere 0)</obj_property>
   </wvobject>
   
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/dut/mult_fifo_rd_valid(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/pipeline_sphere_tb/dut/mult_fifo_rd_tid">
      <obj_property name="ElementShortName">mult_fifo_rd_tid[127:0]</obj_property>
      <obj_property name="ObjectShortName">mult_fifo_rd_tid[127:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/dut/mult_result_valid(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/dut/mult_result_valid_gated(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
      <obj_property name="CustomSignalColor">#FF0000</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/pipeline_sphere_tb/dut/mult_result_tid">
      <obj_property name="ElementShortName">mult_result_tid[127:0]</obj_property>
      <obj_property name="ObjectShortName">mult_result_tid[127:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   
   <wvobject type="divider" fp_name="divider5">
