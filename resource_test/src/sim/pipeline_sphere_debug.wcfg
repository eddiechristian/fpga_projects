   </wvobject>
   
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/dut/fma_fifo_rd_valid(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
      <obj_property name="CustomSignalColor">#FFFF00</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/pipeline_sphere_tb/dut/fma_fifo_rd_tid">
      <obj_property name="ElementShortName">fma_fifo_rd_tid[79:0]</obj_property>
      <obj_property name="ObjectShortName">fma_fifo_rd_tid[79:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/dut/fma_result_valid(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/pipeline_sphere_tb/dut/fma_result_valid_gated(0)">
      <obj_property name="ElementShortName">(0)</obj_property>
      <obj_property name="ObjectShortName">(0)</obj_property>
      <obj_property name="CustomSignalColor">#FF0000</obj_property>
